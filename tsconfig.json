{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["chrome", "node"]
  },
  "include": [
    "src",
    "tests",
    "mcp/src",
    "mcp/tests",
    "mcp/vite.config.ts",
    "vite.config.ts",
    "vite.content.config.ts",
    "playwright.config.ts"
  ]
}
