{
  "manifest_version": 3,
  "name": "CONTRI \u2014 Open Source Compass",
  "short_name": "CONTRI",
  "version": "0.4.0",
  "description": "Find open-source issues you can actually take: project activity, team reply times, claims and linked PRs, right on GitHub.",
  "homepage_url": "https://contri-two.vercel.app",
  "minimum_chrome_version": "124",
  "action": {
    "default_title": "Open CONTRI"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting", "alarms", "notifications"],
  "host_permissions": ["https://api.github.com/*", "https://github.com/*"],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "options_page": "settings.html",
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["widget.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["https://github.com/*"],
      "use_dynamic_url": true
    }
  ]
}
