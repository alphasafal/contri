{
  "name": "contri",
  "private": true,
  "version": "0.3.3",
  "description": "Find open-source issues you can actually take — see if a repo is alive, if maintainers reply, and if an issue is already claimed. Right on GitHub.",
  "keywords": [
    "open-source",
    "hacktoberfest",
    "good-first-issue",
    "first-timers",
    "beginner-friendly",
    "github",
    "browser-extension",
    "chrome-extension",
    "contributors",
    "developer-tools"
  ],
  "homepage": "https://contri-two.vercel.app",
  "bugs": {
    "url": "https://github.com/alphasafal/contri/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alphasafal/contri.git"
  },
  "license": "MIT",
  "author": "Safal Gupta (https://github.com/alphasafal)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "mcp"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run check:docs && npm test && npm run build && npm run build:mcp",
    "package": "npm run build && node scripts/package.mjs",
    "package:firefox": "npm run build && node scripts/package.mjs --firefox",
    "verify:package": "node scripts/verify-package.mjs",
    "screenshots": "CONTRI_SCREENSHOTS=1 playwright test screenshots && node scripts/webp.mjs",
    "check:docs": "node scripts/check-links.mjs",
    "build:mcp": "npm run build -w contri-mcp"
  },
  "dependencies": {
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
