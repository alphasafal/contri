{
  "name": "contri",
  "private": true,
  "version": "0.3.0",
  "description": "Find open-source issues you can actually take: project activity, maintainer reply times, claims and linked PRs, right on GitHub.",
  "keywords": [
    "open-source",
    "good-first-issue",
    "github",
    "browser-extension",
    "chrome-extension",
    "contributors",
    "hacktoberfest",
    "developer-tools"
  ],
  "homepage": "https://contri-two.vercel.app",
  "bugs": {
    "url": "https://github.com/alphasafal/contri/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alphasafal/contri.git"
  },
  "license": "MIT",
  "author": "Safal Gupta (https://github.com/alphasafal)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm test && npm run build",
    "package": "npm run build && node scripts/package.mjs",
    "package:firefox": "npm run build && node scripts/package.mjs --firefox",
    "verify:package": "node scripts/verify-package.mjs",
    "screenshots": "CONTRI_SCREENSHOTS=1 playwright test screenshots && node scripts/webp.mjs"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.0.308",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sharp": "^0.34.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
